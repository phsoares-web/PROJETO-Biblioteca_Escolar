<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrar Empréstimo</title>

    <link rel="stylesheet" href="/public/style.css">
</head>
<body>

<header class="header">
    <div class="header-container">
        <div class="logo">
            <img src="/logo-winrar.png" alt="Logo" class="logo-img">
            <h1>Biblioteca Escolar</h1>
        </div>

        <p class="subtitle">
            Registro de Empréstimos
        </p>
    </div>
</header>

<main class="container">

    <div class="form-card">

        <h2>Registrar Empréstimo</h2>

        <% if (erro) { %>
            <div class="erro">
                <%= erro %>
            </div>
        <% } %>

        <form action="/emprestimos" method="POST">

            <div class="form-group">
                <label for="alunoId">Aluno</label>

                <select
                    id="alunoId"
                    name="alunoId"
                    required
                >
                    <option value="">
                        Selecione um aluno
                    </option>

                    <% alunos.forEach(aluno => { %>

                        <option value="<%= aluno.id %>">
                            <%= aluno.nome %>
                        </option>

                    <% }) %>

                </select>
            </div>

            <div class="form-group">
                <label for="livroId">Livro</label>

                <select
                    id="livroId"
                    name="livroId"
                    required
                >
                    <option value="">
                        Selecione um livro
                    </option>

                    <% livros.forEach(livro => { %>

                        <option value="<%= livro.id %>">
                            <%= livro.titulo %> - <%= livro.autor %>
                        </option>

                    <% }) %>

                </select>
            </div>

            <div class="form-group">
                <label for="dataDevolucaoPrevista">
                    Data prevista para devolução
                </label>

                <input
                    type="date"
                    id="dataDevolucaoPrevista"
                    name="dataDevolucaoPrevista"
                    required
                >
            </div>

            <button
                type="submit"
                class="btn-submit"
            >
                Registrar Empréstimo
            </button>

        </form>

        <br>

        <a
            href="/emprestimos"
            class="btn-back"
        >
            ← Voltar para Empréstimos
        </a>

    </div>

</main>

<footer class="footer">
    <p>&copy; Biblioteca Escolar</p>
</footer>

</body>
</html>
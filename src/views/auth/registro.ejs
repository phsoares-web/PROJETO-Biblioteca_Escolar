<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cadastro - Biblioteca Escolar</title>
  <link rel="stylesheet" href="/public/style.css">
  <link rel="stylesheet" href="/loader.css">
</head>
<body>
  <%- include('../partials/loader') %>

  <header class="header">
    <div class="header-container">
      <div class="logo">
        <img src="/public/uploads/logo-winrar.png" alt="Logo WinRAR" class="logo-img">
          <h1>Biblioteca "Aluísio Azevedo"</h1>
      </div>
    <p class="subtitle">
      ✎ᝰ.ᐟ⋆⑅˚₊ Acessando sistema... ᝰ.ᐟ
    </p>
  </header>

  <main class="container flex-center">
    <div class="login-card">

      <% if (typeof erro !== 'undefined' && erro) { %>
        <div style="background-color: #fbe9e7; color: #c62828; border: 1px solid #ffcdd2; padding: 10px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; margin-bottom: 16px; text-align: center;">
          <%= erro %>
        </div>
      <% } %>

      <div class="tabs">
        <a href="/auth/login" class="tab-btn" style="text-decoration: none; text-align: center;">Entrar</a>
        <button type="button" class="tab-btn active">Cadastrar-se</button>
      </div>

      <form id="form-register" action="/auth/registro" method="POST" class="auth-form">
        <div class="form-group">
          <label for="reg-nome">Nome Completo</label>
          <input type="text" id="reg-nome" name="nome" placeholder="Seu nome completo" required>
        </div>

        <div class="form-group">
          <label for="reg-email">E-mail</label>
          <input type="email" id="reg-email" name="email" placeholder="Digite seu e-mail" required>
        </div>

        <div class="form-group">
          <label for="reg-matricula">Matrícula (Obrigatório para Alunos)</label>
          <input type="text" id="reg-matricula" name="matricula" placeholder="Digite sua matrícula escolar">
        </div>

        <div class="form-group">
          <label for="reg-chave">Chave de Acesso Admin (Somente Bibliotecários)</label>
          <input type="password" id="reg-chave" name="chaveAdmin" placeholder="Deixe em branco se você for aluno">
        </div>

        <div class="form-group">
          <label for="reg-senha">Criar Senha</label>
          <div class="password-wrapper">
            <input type="password" id="reg-senha" name="senha" placeholder="Crie uma senha segura" required>
            <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('reg-senha', this)" title="Mostrar/Ocultar senha">
              <svg class="icon-eye" viewBox="0 0 24 24">
                <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-primary">Criar Conta</button>
      </form>

    </div>
  </main>

                  <a
                href="/"
                class="btn-back"
                >
                  ← Voltar para Página Principal
                </a>

             </div>

  <footer class="footer">
    <p>&copy; Bernardo, Paulo, Alice, João Victor e Emanuel</p>
  </footer>

  <script src="/loader.js"></script>
  <script>
    function togglePasswordVisibility(inputId, btnElement) {
      const input = document.getElementById(inputId);
      const isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';

      const eyeOpenSvg = `<svg class="icon-eye" viewBox="0 0 24 24"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>`;
      const eyeClosedSvg = `<svg class="icon-eye" viewBox="0 0 24 24"><path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.17c0-1.66-1.34-3-3-3l-.17.02z"/></svg>`;

      btnElement.innerHTML = isPassword ? eyeClosedSvg : eyeOpenSvg;
    }
  </script>

</body>
</html>
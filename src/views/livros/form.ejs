<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= livro && livro.id ? "Editar Livro" : "Cadastrar Livro" %>
  </title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/loader.css">
</head>

<body>
  <%- include('../partials/loader') %>

    <header class="header">
      <div class="header-container">
        <div class="logo">
          <img src="/uploads/logo-winrar.png" alt="Logo da Biblioteca" class="logo-img">
          <h1>Biblioteca "Aluísio Azevedo"</h1>
      </div>
        <p class="subtitle">
          ✎ᝰ.ᐟ⋆⑅˚₊ Construindo novas histórias... ᝰ.ᐟ
        </p>
      </div>
    </header>

    <main class="container">

      <div class="form-card">

        <h2>
          <%= livro && livro.id ? "Editar Livro" : "Cadastrar Novo Livro" %>
        </h2>

        <% if (erro) { %>
          <div class="erro">
            <%= erro %>
          </div>
          <% } %>

            <form action="<%= livro && livro.id ? '/livros/' + livro.id + '?_method=PUT' : '/livros' %>" method="POST"
              enctype="multipart/form-data">

              <div class="form-group">
                <label for="titulo">Título</label>

                <input type="text" id="titulo" name="titulo" required value="<%= livro ? livro.titulo : '' %>">
              </div>

              <div class="form-group">
                <label for="autor">Autor</label>

                <input type="text" id="autor" name="autor" required value="<%= livro ? livro.autor : '' %>">
              </div>

              <div class="form-group">
                <label>Capa do Livro</label>
                <div class="file-upload-wrapper">
                  <label for="capa" class="btn-upload-custom">
                    <span>Escolher Arquivo</span>
                  </label>
                  <span class="file-name-text" id="nome-arquivo-capa">Nenhum arquivo selecionado</span>
                </div>
                <input type="file" id="capa" name="capa" accept="image/*" class="file-input-hidden">
                <% if (livro && livro.capaUrl) { %>
                  <img src="<%= livro.capaUrl %>" alt="Capa" class="preview-capa">
                  <% } %>
              </div>

              <button type="submit" class="btn-submit">

                <%= livro && livro.id ? "Salvar Alterações" : "Cadastrar Livro" %>

              </button>

            </form>

            <br>

            <a href="/livros" class="btn-back">
              ← Voltar para a Biblioteca
            </a>

      </div>

    </main>

    <footer class="footer">
      <p>
        &copy; Biblioteca Escolar
      </p>
    </footer>

    <script src="/loader.js"></script>
    <script>
      document.getElementById('capa').addEventListener('change', function () {
        const texto = document.getElementById('nome-arquivo-capa');
        texto.textContent = this.files.length > 0 ? this.files[0].name : 'Nenhum arquivo selecionado';
      });
    </script>

</body>

</html>
<!DOCTYPE html>
<html lang="pt-BR">

<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>
   <%= livro && livro.id ? "Editar Livro" : "Cadastrar Livro" %>
 </title>

 <link rel="stylesheet" href="/style.css">
</head>

<body>

 <header class="header">
   <div class="header-container">
     <div class="logo">
       <img src="public/uploads/logo-winrar.png" alt="Logo" class="logo-img">
       <h1>Biblioteca Escolar</h1>
     </div>

     <p class="subtitle">
       Cadastro de Livros
     </p>
   </div>
 </header>

 <main class="container">

   <div class="form-card">

     <h2>
       <%= livro && livro.id ? "Editar Livro" : "Cadastrar Novo Livro" %>
     </h2>

     <% if (erro) { %>
       <div class="erro">
         <%= erro %>
       </div>
       <% } %>

         <form action="<%= livro && livro.id ? '/livros/' + livro.id : '/livros' %>" method="POST"
           enctype="multipart/form-data">

           <div class="form-group">
             <label for="titulo">Título</label>

             <input type="text" id="titulo" name="titulo" required value="<%= livro ? livro.titulo : '' %>">
           </div>

           <div class="form-group">
             <label for="autor">Autor</label>

             <input type="text" id="autor" name="autor" required value="<%= livro ? livro.autor : '' %>">
           </div>

           <div class="form-group">

             <label for="capa">
               Capa do Livro
             </label>

             <input type="file" id="capa" name="capa" accept="image/*">

             <% if (livro && livro.capaUrl) { %>

               <br>

               <img src="<%= livro.capaUrl %>" alt="Capa" class="preview-capa">

               <% } %>

           </div>

           <button type="submit" class="btn-submit">

             <%= livro && livro.id ? "Salvar Alterações" : "Cadastrar Livro" %>

           </button>

         </form>

         <br>

         <a href="/livros" class="btn-back">
           ← Voltar para a Biblioteca
         </a>

   </div>

 </main>

 <footer class="footer">
   <p>
     &copy; Biblioteca Escolar
   </p>
 </footer>

</body>

</html>

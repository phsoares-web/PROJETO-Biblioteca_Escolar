<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Acesso - <%= titulo %></title>
  <link rel="stylesheet" href="/style.css">
  <style>
    /* Estilos para o campo de senha com ícone de olho */
    .password-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .password-wrapper input {
      width: 100%;
      padding-right: 40px; /* Espaço para o botão do olho */
    }

    .toggle-password-btn {
      position: absolute;
      right: 10px;
      background: transparent;
      border: none;
      cursor: pointer;
      color: #666;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4px;
      border-radius: 4px;
      transition: color 0.2s;
    }

    .toggle-password-btn:hover {
      color: #3d2410;
    }

    .toggle-password-btn svg {
      width: 20px;
      height: 20px;
      fill: currentColor;
    }
  </style>
</head>
<body>

  <header class="header">
    <div class="header-container">
      <div class="logo">
        <img src="/uploads/logo-winrar.png" alt="Logo WinRAR" class="logo-img">
        <h1><%= titulo %></h1>
      </div>
      <p class="subtitle">Acesso ao Sistema</p>
    </div>
  </header>

  <main class="container flex-center">
    <div class="login-card">
      
      <!-- EXIBIÇÃO DE MENSAGEM DE ERRO (CASO EXISTA) -->
      <% if (typeof erro !== 'undefined' && erro) { %>
        <div style="background-color: #fbe9e7; color: #c62828; border: 1px solid #ffcdd2; padding: 10px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; margin-bottom: 16px; text-align: center;">
          <%= erro %>
        </div>
      <% } %>

      <!-- Abas para Trocar entre Entrar e Cadastrar -->
      <div class="tabs">
        <button id="tab-login" class="tab-btn active" onclick="switchTab('login')">Entrar</button>
        <button id="tab-register" class="tab-btn" onclick="switchTab('register')">Cadastrar-se</button>
      </div>

      <!-- FORMULÁRIO DE LOGIN -->
      <form id="form-login" action="/login" method="POST" class="auth-form">
        <div class="form-group">
          <label for="login-email">E-mail</label>
          <input type="email" id="login-email" name="email" placeholder="seu@email.com" required>
        </div>

        <div class="form-group">
          <label for="login-senha">Senha</label>
          <div class="password-wrapper">
            <input type="password" id="login-senha" name="senha" placeholder="••••••••" required>
            <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('login-senha', this)" title="Mostrar/Ocultar senha">
              <!-- Ícone de Olho Fechado (Padrão) -->
              <svg class="icon-eye" viewBox="0 0 24 24">
                <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-primary">Entrar</button>
      </form>

      <!-- FORMULÁRIO DE CADASTRO -->
      <form id="form-register" action="/register" method="POST" class="auth-form hidden">
        <div class="form-group">
          <label for="reg-nome">Nome Completo</label>
          <input type="text" id="reg-nome" name="nome" placeholder="Seu nome" required>
        </div>

        <div class="form-group">
          <label for="reg-email">E-mail</label>
          <input type="email" id="reg-email" name="email" placeholder="seu@email.com" required>
        </div>

        <div class="form-group">
          <label for="reg-senha">Criar Senha</label>
          <div class="password-wrapper">
            <input type="password" id="reg-senha" name="senha" placeholder="Crie uma senha" required>
            <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('reg-senha', this)" title="Mostrar/Ocultar senha">
              <!-- Ícone de Olho Fechado (Padrão) -->
              <svg class="icon-eye" viewBox="0 0 24 24">
                <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-primary">Criar Conta</button>
      </form>

    </div>
  </main>

  <footer class="footer">
    <p>&copy; Bernardo, Paulo, Alice, João Victor e Emanuel</p>
  </footer>

  <!-- Script para alternar as abas e visibilidade da senha -->
  <script>
    function switchTab(tab) {
      const formLogin = document.getElementById('form-login');
      const formRegister = document.getElementById('form-register');
      const tabLogin = document.getElementById('tab-login');
      const tabRegister = document.getElementById('tab-register');

      if (tab === 'login') {
        formLogin.classList.remove('hidden');
        formRegister.classList.add('hidden');
        tabLogin.classList.add('active');
        tabRegister.classList.remove('active');
      } else {
        formLogin.classList.add('hidden');
        formRegister.classList.remove('hidden');
        tabRegister.classList.add('active');
        tabLogin.classList.remove('active');
      }
    }

    // Função para ver / ocultar a senha
    function togglePasswordVisibility(inputId, btnElement) {
      const input = document.getElementById(inputId);
      const isPassword = input.type === 'password';

      // Alterna entre o tipo password e text
      input.type = isPassword ? 'text' : 'password';

      // SVGs dos ícones
      const eyeOpenSvg = `<svg class="icon-eye" viewBox="0 0 24 24"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>`;
      
      const eyeClosedSvg = `<svg class="icon-eye" viewBox="0 0 24 24"><path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.17c0-1.66-1.34-3-3-3l-.17.02z"/></svg>`;

      // Altera o ícone do botão
      btnElement.innerHTML = isPassword ? eyeClosedSvg : eyeOpenSvg;
    }
  </script>

</body>
</html>
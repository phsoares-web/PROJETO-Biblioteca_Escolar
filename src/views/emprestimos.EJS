<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/style.css">
  <style>
    :root {
      --primary-color: #3d2410;
      --primary-hover: #2b1810;
      --accent-color: #8b5a2b;
      --bg-color: #fcf9f5;
      --card-bg: #ffffff;
      --text-main: #2b1810;
      --text-muted: #666666;
      --border-color: #d4c5b9;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .header {
      background-color: var(--card-bg);
      border-bottom: 1px solid var(--border-color);
      padding: 15px 30px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .header-content {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .header-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--primary-color);
      margin: 0;
    }

    .header-nav {
      display: flex;
      gap: 20px;
      align-items: center;
    }

    .header-nav a {
      text-decoration: none;
      color: var(--primary-color);
      font-weight: 600;
      font-size: 0.95rem;
      transition: color 0.2s;
    }

    .header-nav a:hover {
      color: var(--accent-color);
    }

    .main-container {
      max-width: 1100px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .form-card {
      background: var(--card-bg);
      border-radius: 12px;
      box-shadow: 0 6px 20px rgba(61, 36, 16, 0.06);
      padding: 30px;
      margin-bottom: 40px;
      border: 1px solid rgba(212, 197, 185, 0.4);
    }

    .section-heading {
      font-size: 1.25rem;
      color: var(--primary-color);
      margin-top: 0;
      margin-bottom: 24px;
      font-weight: 700;
      letter-spacing: -0.3px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group.full-width {
      grid-column: span 2;
    }

    label {
      display: block;
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--text-main);
      margin-bottom: 8px;
    }

    select, input {
      width: 100%;
      padding: 12px 16px;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      font-size: 0.95rem;
      background-color: #fff;
      color: var(--text-main);
      transition: all 0.2s ease;
      box-sizing: border-box;
    }

    select:focus, input:focus {
      outline: none;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 3px rgba(61, 36, 16, 0.1);
    }

    .btn-submit {
      background-color: var(--primary-color);
      color: white;
      border: none;
      padding: 12px 28px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.95rem;
      cursor: pointer;
      transition: background-color 0.2s, transform 0.1s;
    }

    .btn-submit:hover {
      background-color: var(--primary-hover);
    }

    .table-container {
      background: var(--card-bg);
      border-radius: 12px;
      box-shadow: 0 6px 20px rgba(61, 36, 16, 0.06);
      overflow: hidden;
      border: 1px solid rgba(212, 197, 185, 0.4);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th {
      background-color: var(--primary-color);
      color: white;
      padding: 16px 20px;
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: 0.3px;
    }

    td {
      padding: 16px 20px;
      border-bottom: 1px solid #f0e6df;
      font-size: 0.95rem;
      color: var(--text-main);
    }

    tr:last-child td {
      border-bottom: none;
    }

    tr:hover td {
      background-color: #fcf8f5;
    }

    .badge {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .badge.ativo {
      background-color: #fef3c7;
      color: #92400e;
    }

    .badge.devolvido {
      background-color: #d1fae5;
      color: #065f46;
    }

    .btn-return {
      background-color: #059669;
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.2s;
    }

    .btn-return:hover {
      background-color: #047857;
    }
  </style>
</head>
<body>

  <header class="header">
    <div class="header-content">
      <h1 class="header-title">Gestão de Empréstimos</h1>
      <nav class="header-nav">
        <a href="/">&larr; Voltar para Livros</a>
        <a href="/logout">Sair</a>
      </nav>
    </div>
  </header>

  <main class="main-container">
    
    <div class="form-card">
      <h2 class="section-heading">Registrar Novo Empréstimo</h2>
      <form action="/emprestimos" method="POST">
        <div class="form-grid">
          <div class="form-group full-width">
            <label for="livroId">Livro Disponível</label>
            <select name="livroId" id="livroId" required>
              <option value="" disabled selected>-- Selecione um livro do acervo --</option>
              <% if (typeof livrosDisponiveis !== 'undefined') { %>
                <% livrosDisponiveis.forEach(livro => { %>
                  <option value="<%= livro.id %>"><%= livro.titulo %> - <%= livro.autor %></option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <div class="form-group">
            <label for="aluno">Nome do Aluno ou Usuário</label>
            <input type="text" id="aluno" name="aluno" placeholder="Ex: Maria Silva" required>
          </div>

          <div class="form-group">
            <label for="dataDevolucao">Previsão para Devolução</label>
            <!-- Alterado para type="date" para habilitar o calendário do navegador -->
            <input type="date" id="dataDevolucao" name="dataDevolucao" required>
          </div>
        </div>

        <button type="submit" class="btn-submit">Confirmar Empréstimo</button>
      </form>
    </div>

    <div class="table-container">
      <div style="padding: 24px 24px 0 24px;">
        <h2 class="section-heading" style="margin-bottom: 0;">Histórico de Empréstimos</h2>
      </div>
      <div style="overflow-x: auto; margin-top: 16px;">
        <table>
          <thead>
            <tr>
              <th>Livro</th>
              <th>Aluno</th>
              <th>Data Retirada</th>
              <th>Previsão Devolução</th>
              <th>Status</th>
              <th>Ação</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof emprestimos !== 'undefined' && emprestimos.length > 0) { %>
              <% emprestimos.forEach(emp => { %>
                <tr>
                  <td><strong><%= emp.livroTitulo %></strong></td>
                  <td><%= emp.aluno %></td>
                  <td><%= emp.dataRetirada %></td>
                  <td><%= emp.dataDevolucao %></td>
                  <td>
                    <span class="badge <%= emp.status === 'Ativo' ? 'ativo' : 'devolvido' %>">
                      <%= emp.status %>
                    </span>
                  </td>
                  <td>
                    <% if (emp.status === 'Ativo') { %>
                      <button class="btn-return" onclick="registrarDevolucao('<%= emp.id %>')">Registrar Devolução</button>
                    <% } else { %>
                      <span style="color: var(--text-muted); font-size: 0.85rem;">Concluído</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 30px;">Nenhum empréstimo registrado no momento.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <script>
    async function registrarDevolucao(id) {
      try {
        const response = await fetch(`/emprestimos/${id}/devolver`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        if (response.ok) {
          window.location.reload();
        } else {
          alert('Erro ao registrar devolução.');
        }
      } catch (err) {
        console.error(err);
      }
    }
  </script>
</body>
</html>
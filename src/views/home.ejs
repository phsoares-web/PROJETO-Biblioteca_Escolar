<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Biblioteca Escolar</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>

<header class="header">
  <div class="header-container">
    <div class="logo">
      <img src="/public/uploads/logo-winrar.png" alt="Logo" class="logo-img">
      <h1>Biblioteca Escolar</h1>
    </div>
    <p class="subtitle">Bem-vindo ao Sistema</p>
  </div>
</header>

<main class="container flex-center">
  <div class="login-card" style="text-align: center;">
    <h2 style="margin-bottom: 20px;">Gerencie o acervo da biblioteca escolar</h2>
    <p style="margin-bottom: 24px; color: #5C3A21;">
      Faça login para acessar o catálogo ou crie uma conta gratuita.
    </p>
    <a href="/auth/login" class="btn-primary" style="display:block; margin-bottom: 12px;">Entrar</a>
    <a href="/auth/registro" class="btn-primary" style="display:block; background-color: transparent; color:#4A2E1B; border: 1px solid #4A2E1B;">Criar Conta</a>
  </div>
</main>

<footer class="footer">
  <p>&copy; Biblioteca Escolar</p>
</footer>

</body>
</html>
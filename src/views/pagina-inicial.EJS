<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/style.css">
  <style>
    /* Estilo do container da Capa no Card */
    .book-cover {
      height: 200px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #8c6239;
      border-radius: 8px 8px 0 0;
    }

    .book-cover-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .book-cover-placeholder {
      font-size: 3.5rem;
    }

    /* Estilos para os badges de Status */
    .status {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: bold;
      text-transform: uppercase;
      margin-top: 5px;
    }

    /* Disponível (Verde) */
    .status.available {
      background-color: #e6f4ea;
      color: #1e7e34;
      border: 1px solid #c3e6cb;
    }

    /* Emprestado (Vermelho/Rosado) */
    .status.borrowed {
      background-color: #fbe9e7;
      color: #c62828;
      border: 1px solid #ffcdd2;
    }

    /* Estilos para os botões de ação do card */
    .book-actions {
      display: flex;
      gap: 8px;
      margin-top: 12px;
    }

    .btn-action {
      flex: 1;
      padding: 6px 10px;
      border-radius: 4px;
      font-size: 0.8rem;
      font-weight: bold;
      text-align: center;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: opacity 0.2s;
    }

    .btn-action:hover {
      opacity: 0.85;
    }

    .btn-edit {
      background-color: #8c6239;
      color: white;
    }

    .btn-delete {
      background-color: #a83232;
      color: white;
    }
  </style>
</head>
<body>

  <header class="header">
    <div class="header-top">
      <a href="/login" class="btn-header-login">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2 5s-1 1-4 1-4-1-4-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C9.516 10.68 8.289 10 6 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
        </svg>
        Entrar
      </a>
    </div>

    <div class="header-container">
      <div class="logo">
        <img src="/logo-winrar.png" alt="Logo WinRAR" class="logo-img">
        <h1><%= titulo %></h1>
      </div>
      <p class="subtitle">Acervo e Catálogo Digital</p>
    </div>
  </header>

  <main class="container">
    <section class="catalog-section">
      
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2>Livros Disponíveis</h2>
        <a href="/livros/novo" style="background-color: #3d2410; color: #ffffff; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-weight: bold; font-size: 0.9rem; transition: background-color 0.2s;">
          + Cadastrar Livro
        </a>
      </div>

      <div class="books-grid">
        
        <% itens.forEach(livro => { %>
          <div class="book-card" data-id="<%= livro.id %>">
            
            <!-- Renderização da Capa: Exibe a foto se cadastrada, ou o emoji se não houver foto -->
            <div class="book-cover">
              <% if (livro.capa) { %>
                <img src="<%= livro.capa %>" alt="<%= livro.titulo %>" class="book-cover-img">
              <% } else { %>
                <span class="book-cover-placeholder">📖</span>
              <% } %>
            </div>

            <div class="book-info">
              <h3><%= livro.titulo %></h3>
              
              <% if (livro.autor) { %>
                <p style="font-size: 0.85rem; color: #666; margin: 4px 0;"><%= livro.autor %></p>
              <% } %>

              <!-- Badge do Status -->
              <span class="status <%= livro.status === 'disponivel' ? 'available' : 'borrowed' %>">
                <%= livro.status %>
              </span>

              <!-- Botões de Ação -->
              <div class="book-actions">
                <a href="/livros/editar/<%= livro.id %>" class="btn-action btn-edit">Editar</a>
                
                <form action="/livros/deletar/<%= livro.id %>" method="POST" style="flex: 1;" onsubmit="return confirm('Tem certeza que deseja remover este livro?');">
                  <button type="submit" class="btn-action btn-delete" style="width: 100%;">Excluir</button>
                </form>
              </div>

            </div>
          </div>
        <% }) %>

      </div>
    </section>
  </main>

  <footer class="footer">
    <p>&copy; Bernardo, Paulo, Alice, João Victor e Emanuel</p>
  </footer>

</body>
</html>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <header class="header">
    <div class="header-top">
      <a href="/login" class="btn-header-login">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2 5s-1 1-4 1-4-1-4-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C9.516 10.68 8.289 10 6 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
        </svg>
        Entrar
      </a>
    </div>

    <div class="header-container">
      <div class="logo">
        <img src="/logo-winrar.png" alt="Logo WinRAR" class="logo-img">
        <h1><%= titulo %></h1>
      </div>
      <p class="subtitle">Acervo e Catálogo Digital</p>
    </div>
  </header>

  <main class="container">
    
    <!-- BARRA DE BUSCA -->
    <section class="search-section">
      <form id="search-form" class="search-container">
        <input 
          type="text" 
          id="search-input" 
          class="search-input" 
          placeholder="Buscar livro por título..."
        >
        <button type="submit" class="btn-search">Buscar</button>
      </form>
    </section>

    <!-- LISTAGEM DE LIVROS -->
    <section class="catalog-section">
      <h2>Acervo de Livros</h2>
      <div class="books-grid" id="books-grid">
        
        <% itens.forEach(livro => { %>
          <div class="book-card" data-id="<%= livro.id %>">
            <div class="book-cover">📖</div>
            <div class="book-info">
              <h3><%= livro.titulo %></h3>
              <span class="status <%= livro.status === 'disponivel' ? 'available' : 'borrowed' %>">
                <%= livro.status %>
              </span>
            </div>
          </div>
        <% }) %>

      </div>
    </section>
  </main>

  <footer class="footer">
    <p>&copy; Bernardo, Paulo, Alice, João Victor e Emanuel</p>
  </footer>

  <!-- SCRIPT DE BUSCA DINÂMICA -->
  <script>
    const searchForm = document.getElementById('search-form');
    const searchInput = document.getElementById('search-input');
    const booksGrid = document.getElementById('books-grid');

    async function buscarLivros(termo = '') {
      try {
        const response = await fetch(`/api/livros?busca=${encodeURIComponent(termo)}`);
        const livros = await response.json();

        booksGrid.innerHTML = '';

        if (livros.length === 0) {
          booksGrid.innerHTML = '<p style="grid-column: 1/-1; text-align: center; color: #8D6E63;">Nenhum livro encontrado.</p>';
          return;
        }

        livros.forEach(livro => {
          const isAvailable = livro.status === 'disponivel';
          const cardHtml = `
            <div class="book-card" data-id="${livro.id}">
              <div class="book-cover">📖</div>
              <div class="book-info">
                <h3>${livro.titulo}</h3>
                <span class="status ${isAvailable ? 'available' : 'borrowed'}">
                  ${livro.status}
                </span>
              </div>
            </div>
          `;
          booksGrid.innerHTML += cardHtml;
        });
      } catch (error) {
        console.error('Erro ao buscar livros:', error);
      }
    }

    // Busca ao submeter o formulário
    searchForm.addEventListener('submit', (e) => {
      e.preventDefault();
      buscarLivros(searchInput.value);
    });

    // Busca instantânea enquanto digita
    searchInput.addEventListener('input', () => {
      buscarLivros(searchInput.value);
    });
  </script>

</body>
</html>
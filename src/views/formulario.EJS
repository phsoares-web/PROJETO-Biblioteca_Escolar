<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= livro && livro.id ? 'Editar Livro' : 'Cadastrar Livro' %> - Biblioteca Aluísio Azevedo</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/loader.css">
  <style>
    /* Estilos específicos para harmonizar a caixa de formulário com o tema */
    .form-wrapper {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 40px 20px;
    }

    .form-card {
      background: #ffffff;
      padding: 30px 35px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
      width: 100%;
      max-width: 500px;
    }

    .form-card h2 {
      color: #3d2410;
      font-size: 1.5rem;
      margin-bottom: 20px;
      text-align: center;
      border-bottom: 2px solid #f0e6d2;
      padding-bottom: 10px;
    }

    .form-group {
      margin-bottom: 18px;
    }

    .form-group label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
      color: #3d2410;
      font-size: 0.9rem;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #dcd1ba;
      border-radius: 6px;
      background-color: #fcfaf5;
      font-size: 0.95rem;
      color: #333;
      box-sizing: border-box;
      transition: border-color 0.2s;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: #3d2410;
    }

    /* --- ESTILIZAÇÃO CUSTOMIZADA DO UPLOAD DE ARQUIVO --- */
    .file-upload-wrapper {
      display: flex;
      align-items: center;
      gap: 12px;
      background-color: #fcfaf5;
      border: 1px solid #dcd1ba;
      border-radius: 6px;
      padding: 6px 10px;
      margin-top: 4px;
    }

    .file-input-hidden {
      display: none;
    }

    .btn-upload-custom {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background-color: #3d2410;
      color: #ffffff;
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.2s ease, transform 0.1s ease;
    }

    .btn-upload-custom:hover {
      background-color: #2b190a;
    }

    .btn-upload-custom:active {
      transform: scale(0.98);
    }

    .file-name-text {
      font-size: 0.85rem;
      color: #666;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 220px;
    }

    .form-row {
      display: flex;
      gap: 15px;
    }

    .form-row .form-group {
      flex: 1;
    }

    .btn-submit {
      width: 100%;
      background-color: #3d2410;
      color: #ffffff;
      border: none;
      padding: 12px;
      border-radius: 6px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      margin-top: 10px;
      transition: background-color 0.2s;
    }

    .btn-submit:hover {
      background-color: #2b190a;
    }

    .btn-back {
      display: block;
      text-align: center;
      margin-top: 15px;
      color: #666;
      text-decoration: none;
      font-size: 0.9rem;
    }

    .btn-back:hover {
      text-decoration: underline;
    }

    .preview-capa {
      display: block;
      max-width: 100px;
      max-height: 140px;
      margin-top: 8px;
      border-radius: 4px;
      border: 1px solid #dcd1ba;
      object-fit: cover;
    }
  </style>
</head>
<body>

  <!-- Cabeçalho idêntico ao do seu site -->
  <header>
    <div class="header-container">
      <h1>📚 Biblioteca Aluísio Azevedo</h1>
      <p>CADASTRO DE ACERVO</p>
    </div>
  </header>

  <!-- Conteúdo Principal -->
  <main class="form-wrapper">
    <div class="form-card">
      <h2><%= livro && livro.id ? 'Editar Livro' : 'Cadastrar Novo Livro' %></h2>

      <form action="<%= livro && livro.id ? '/livros/editar/' + livro.id : '/livros/novo' %>" method="POST" enctype="multipart/form-data">
        
        <div class="form-group">
          <label for="titulo">Título do Livro</label>
          <input type="text" id="titulo" name="titulo" value="<%= livro ? livro.titulo : '' %>" required placeholder="Digite o título...">
        </div>

        <div class="form-group">
          <label for="autor">Autor(a)</label>
          <input type="text" id="autor" name="autor" value="<%= livro ? livro.autor : '' %>" placeholder="Ex: Machado de Assis">
        </div>

        <!-- CAMPO CUSTOMIZADO DE UPLOAD DA CAPA -->
        <div class="form-group">
          <label for="capa">Foto da Capa</label>
          
          <div class="file-upload-wrapper">
            <input type="file" id="capa" name="capa" accept="image/*" class="file-input-hidden" onchange="atualizarNomeArquivo(this)">
            
            <label for="capa" class="btn-upload-custom">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                <path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z"/>
              </svg>
              <span>Escolher Imagem</span>
            </label>
            
            <span id="file-name-display" class="file-name-text">Nenhum arquivo selecionado</span>
          </div>

          <% if (livro && livro.capa) { %>
            <p style="font-size: 0.8rem; color: #666; margin-top: 10px; margin-bottom: 4px;">Capa atual:</p>
            <img src="<%= livro.capa %>" alt="Capa do livro" class="preview-capa">
          <% } %>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status">
              <option value="disponivel" <%= livro && livro.status === 'disponivel' ? 'selected' : '' %>>Disponível</option>
              <option value="emprestado" <%= livro && livro.status === 'emprestado' ? 'selected' : '' %>>Emprestado</option>
            </select>
          </div>
        </div>

        <button type="submit" class="btn-submit">
          <%= livro && livro.id ? 'Salvar Alterações' : 'Cadastrar Livro' %>
        </button>

        <a href="/" class="btn-back">← Voltar para o Catálogo</a>
      </form>
    </div>
  </main>

  <!-- Rodapé padrão do seu projeto -->
  <footer>
    <p>&copy; Bernardo, Paulo, Alice, João Victor e Emanuel</p>
  </footer>

  <script src="/loader.js"></script>
  <!-- Script para atualizar o texto do arquivo selecionado -->
  <script>
    function atualizarNomeArquivo(input) {
      const fileNameDisplay = document.getElementById('file-name-display');
      if (input.files && input.files.length > 0) {
        fileNameDisplay.textContent = input.files[0].name;
        fileNameDisplay.style.color = '#3d2410';
        fileNameDisplay.style.fontWeight = 'bold';
      } else {
        fileNameDisplay.textContent = 'Nenhum arquivo selecionado';
        fileNameDisplay.style.color = '#666';
        fileNameDisplay.style.fontWeight = 'normal';
      }
    }
  </script>

</body>
</html>